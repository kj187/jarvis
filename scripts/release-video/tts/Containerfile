# Local text-to-speech for the release video (.agents/skills/release-video/SKILL.md).
# Kokoro-82M (Apache-2.0) via kokoro-onnx with the int8-quantized model: runs on
# CPU in well under 1 GB RAM — the PyTorch build is OOM-killed in a 2 GB
# podman machine. No account, no API key, nothing leaves the machine.
FROM docker.io/library/python:3.12-slim

RUN pip install --no-cache-dir kokoro-onnx==0.6.1 soundfile==0.14.0

ADD --chmod=644 --checksum=sha256:6e742170d309016e5891a994e1ce1559c702a2ccd0075e67ef7157974f6406cb \
    https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.int8.onnx /models/kokoro.onnx
ADD --chmod=644 --checksum=sha256:bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d \
    https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin /models/voices.bin

COPY tts.py /tts.py
# Runs as container root on purpose: rootless podman maps it to the invoking host
# user, so the bind-mounted output directory stays writable (like e2e-playwright).
ENTRYPOINT ["python", "/tts.py"]
