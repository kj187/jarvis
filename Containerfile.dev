FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414
RUN apk add --no-cache git
RUN go install github.com/air-verse/air@v1.67.4
WORKDIR /app
# Sources are volume-mounted at runtime.
# GOFLAGS=-mod=mod allows Go to update go.sum automatically.
ENV GOFLAGS=-mod=mod
EXPOSE 8080
CMD ["sh", "-c", "go mod tidy && air -c .air.toml"]
